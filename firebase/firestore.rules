rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return request.auth.token.admin == true; }

    // Admin namespace for privileged data
    match /admin/{docId} {
      allow read: if isSignedIn();
      allow write, update, delete: if isAdmin();
    }

    // Campaign rooms: allow read to signed-in users; writes only by signed-in users.
    match /campaign_rooms/{roomId}/{collectionId=**}/{docId} {
      allow read: if isSignedIn();
      allow write, update, delete: if isSignedIn();
    }

    // Public data collections (adjust as needed)
    match /campaigns/{docId} {
      allow read: if true;
      allow write, update, delete: if isSignedIn();
    }

    match /threads/{docId} {
      allow read: if true;
      allow write, update, delete: if isSignedIn();
    }

    match /comments/{docId} {
      allow read: if true;
      allow write, update, delete: if isSignedIn();
    }
  }
}

