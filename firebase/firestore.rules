rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return request.auth.token.admin == true; }
    function threadParticipants(threadId) {
      return get(/databases/$(database)/documents/dm_threads/$(threadId)).data.participants;
    }
    function isDmParticipant(threadId) {
      return isSignedIn() && (request.auth.uid in threadParticipants(threadId));
    }
    function otherParticipant(threadId) {
      let parts = threadParticipants(threadId);
      return parts[0] == request.auth.uid ? parts[1] : parts[0];
    }
    function isBlockedBetween(a, b) {
      // Either has blocked the other
      return exists(/databases/$(database)/documents/user_blocks/$(a)/blocked/$(b)) ||
             exists(/databases/$(database)/documents/user_blocks/$(b)/blocked/$(a));
    }

    // Admin namespace for privileged data
    match /admin/{docId} {
      allow read: if isSignedIn();
      allow write, update, delete: if isAdmin();
    }

    // Admin audit log: admin-only read/write
    match /admin_audit/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Campaign rooms metadata: owner/moderator control
    function isRoomStaff(roomId) {
      return exists(/databases/$(database)/documents/campaign_rooms/$(roomId)) &&
        (get(/databases/$(database)/documents/campaign_rooms/$(roomId)).data.ownerUid == request.auth.uid ||
         request.auth.uid in (get(/databases/$(database)/documents/campaign_rooms/$(roomId)).data.mods));
    }
    match /campaign_rooms/{roomId} {
      allow read: if isSignedIn();
      // anyone signed-in can create a new room doc as owner
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isRoomStaff(roomId);
    }
    match /campaign_rooms/{roomId}/{collectionId=**}/{docId} {
      allow read: if isSignedIn();
      allow write, update, delete: if isRoomStaff(roomId);
    }

    // Public data collections (adjust as needed)
    match /campaigns/{docId} {
      allow read: if true;
      allow write, update, delete: if isSignedIn();
    }

    match /threads/{docId} {
      allow read: if true;
      // create if signed-in; update/delete if admin or author
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.authorUid);
    }

    match /comments/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.authorUid);
    }

    // Direct Messages (threads + messages)
    match /dm_threads/{threadId} {
      allow read: if isDmParticipant(threadId);
      allow create: if isSignedIn() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants;
      // Participants may update last/updatedAt only
      allow update: if isDmParticipant(threadId) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(["last","updatedAt","participants"]) &&
        request.resource.data.participants == resource.data.participants;
      allow delete: if isAdmin();
    }
    match /dm_threads/{threadId}/messages/{msgId} {
      allow read: if isDmParticipant(threadId);
      allow create: if isDmParticipant(threadId) &&
        request.resource.data.authorUid == request.auth.uid &&
        !isBlockedBetween(request.auth.uid, otherParticipant(threadId));
      allow update, delete: if isAdmin() || (isDmParticipant(threadId) && request.auth.uid == resource.data.authorUid);
    }

    // User block lists
    match /user_blocks/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false; // use subcollection
    }
    match /user_blocks/{uid}/blocked/{target} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Users collection
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Evidence items under a user
    match /users/{uid}/evidence/{docId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Deadlines under a user
    match /users/{uid}/deadlines/{docId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    // RTW goals under a user
    match /users/{uid}/rtw_goals/{docId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Medications and logs under a user
    match /users/{uid}/medications/{docId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write, update, delete: if isSignedIn() && request.auth.uid == uid;
    }
    match /users/{uid}/med_logs/{docId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Chronic condition tracker entries
    match /users/{uid}/chronic_entries/{docId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Adaptive AI Companion moods (allow anon + signed-in read/write to their namespace)
    match /users/{uid}/moods/{docId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid) || (request.auth == null && uid == 'anon');
      allow write, update, delete: if (isSignedIn() && request.auth.uid == uid) || (request.auth == null && uid == 'anon');
    }

    // Mutual aid posts (public list; write if signed-in)
    match /mutual_aid_posts/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /mutual_aid_posts/{docId}/responses/{rid} {
      allow read: if true;
      allow create: if isSignedIn();
    }

    // Public wait time submissions (read public; create any)
    match /public_wait_times/{docId} {
      allow read: if true;
      allow create: if true;
    }

    // Media Studio posts (read public; create signed-in)
    match /media_posts/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Timeline entries (public read; create signed-in)
    match /timeline_entries/{docId} {
      allow read: if true;
      allow create: if isSignedIn();
    }

    // Events (production and preview) - public read; signed-in write with validation
    // Production collection: events_production
    match /events_production/{docId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.title is string &&
        request.resource.data.date is timestamp &&
        request.resource.data.status == 'published' &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() &&
        (request.auth.uid == resource.data.createdBy || isAdmin());
      allow delete: if isSignedIn() &&
        (request.auth.uid == resource.data.createdBy || isAdmin());
    }

    // Preview collection: events_preview
    match /events_preview/{docId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.title is string &&
        request.resource.data.date is timestamp &&
        request.resource.data.status == 'published' &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() &&
        (request.auth.uid == resource.data.createdBy || isAdmin());
      allow delete: if isSignedIn() &&
        (request.auth.uid == resource.data.createdBy || isAdmin());
    }

    // FAQs (public read; admin write)
    match /faqs/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Ratings (public read; one-per-user-per-target via doc id)
    match /ratings/{docId} {
      allow read: if true;
      allow create, update: if isSignedIn() && docId.matches('^' + request.auth.uid + '_.*$');
    }

    // Rating targets (public read; write signed-in)
    match /rating_targets/{docId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    // Wellness reflections under a user
    match /users/{uid}/wellness_reflections/{docId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Testers chat room (signed-in users)
    match /chats/{room}/messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.authorUid);
    }

    // Presence/typing/last_read per room
    match /chats/{room}/presence/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
    match /chats/{room}/typing/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
    match /chats/{room}/last_read/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
