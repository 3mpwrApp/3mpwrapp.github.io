{
  "expo": {
    "name": "3mpwr App - Secure & Private",
    "description": "A privacy-first empowerment app with enterprise-grade security, complete user data ownership, and air-gapped protection. No cloud required.",
    "owner": "empowrapp",
    "slug": "empowrapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-logo.png",
    "scheme": "empowrapp",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "primaryColor": "#000000",
    "web": {
      "url": "https://3mpwrapp.pages.dev"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/6dd0264f-d796-4f63-9590-f82284a48354"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.app3mpwr.app3mpwr",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to capture evidence photos for your personal records",
        "NSPhotoLibraryUsageDescription": "Used to import evidence from your photo library",
        "NSMicrophoneUsageDescription": "Used to record audio evidence for your personal records",
        "NSLocationWhenInUseUsageDescription": "Used to find your local representatives for the Rep Tracker feature",
        "ITSAppUsesNonExemptEncryption": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {}
        },
        "UIBackgroundModes": [
          "background-processing",
          "background-processing"
        ]
      },
      "config": {
        "usesNonExemptEncryption": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand-adaptive.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.app3mpwr.app3mpwr",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_SMS",
        "android.permission.SEND_SMS",
        "android.permission.CALL_PHONE",
        "android.permission.READ_PHONE_STATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "template": "./web/index.html"
    },
    "plugins": [
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "project": "3mpwrapp",
          "organization": "3mpwr-app"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.733708119893-so14q85mmnrtt5ulnan3qjs2o7ll73vs"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6dd0264f-d796-4f63-9590-f82284a48354"
      },
      "EXPO_PUBLIC_DATA_POLICY": "hybrid_byoc",
      "EXPO_PUBLIC_CAMPAIGNS_API_BASE": "https://3mpwrapp-campaigns.empowrapp08162025.workers.dev/api",
      "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "733708119893-vagikeh1bu36n9boma32ic2lbfvbff08.apps.googleusercontent.com",
      "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "733708119893-so14q85mmnrtt5ulnan3qjs2o7ll73vs.apps.googleusercontent.com"
    }
  }
}
