{
  "expo": {
    "name": "3mpowrApp",
    "slug": "empowrapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-logo.png",
    "scheme": "empowrapp",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": false,
    "updates": {
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "runtimeVersion": { "policy": "sdkVersion" },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand-adaptive.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.empowrapp2.empowrapp",
      "blockScreenshots": true,
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "sentry-expo",
        {
          "project": "YOUR_SENTRY_PROJECT",
          "organization": "YOUR_ORG",
          "url": "https://sentry.io/",
          "autoInit": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6dd0264f-d796-4f63-9590-f82284a48354"
      }
    }
  }
}
