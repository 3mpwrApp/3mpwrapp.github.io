#!/bin/bash
# Unified Empowr pre-push quality gate
set -e

echo "[pre-push] Running lint:ci"; npm run lint:ci
echo "[pre-push] Running strict typecheck"; npm run typecheck:strict
echo "[pre-push] i18n assert"; npm run i18n:assert
echo "[pre-push] accessibility scan"; npm run a11y:scan
echo "[pre-push] wcag audit"; npm run wcag:audit

# Enforce route conventions before expensive tests
echo "[pre-push] route conventions (Tabs.Screen names)"; npm run check:tabs:names:strict || { echo "✗ route conventions failed"; exit 1; }

# Enforce per-file perf guard early
echo "[pre-push] performance: max file size"; npm run perf:max-file || { echo "✗ perf max-file failed"; exit 1; }

echo "→ pre-push: typecheck (strict)"; npm run typecheck:strict || { echo "✗ typecheck failed"; exit 1; }
echo "→ pre-push: tests"; npm run test:ci || { echo "✗ tests failed"; exit 1; }

# Auto-commit analytics report if it changed during tests
if ! git diff --quiet -- docs/analytics-report.md; then
  echo "→ pre-push: committing analytics-report.md"
  git add docs/analytics-report.md || true
  git commit -m "docs: update analytics report" --no-verify || true
else
  echo "→ pre-push: analytics-report.md unchanged"
fi

# Allow unset I18N_TEST_BYPASS without nounset error; use default empty string
I18N_TEST_BYPASS_VAL="${I18N_TEST_BYPASS:-}" || true
if [ -z "$I18N_TEST_BYPASS_VAL" ]; then
  echo "→ pre-push: i18n validation"; I18N_DIFF_ALLOW_MISSING=1 npm run i18n:test || { echo "✗ i18n checks failed"; exit 1; }
else
  echo "→ pre-push: i18n validation skipped (I18N_TEST_BYPASS set)"
fi

echo "→ pre-push: i18n missing keys report"; npm run i18n:report || { echo "✗ missing i18n keys"; exit 1; }

echo "✓ pre-push checks passed"
