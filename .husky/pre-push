#!/usr/bin/env bash
# Unified Empowr pre-push quality gate
set -euo pipefail

echo "[pre-push] Running lint:ci"; npm run lint:ci
echo "[pre-push] Running strict typecheck"; npm run typecheck:strict
echo "[pre-push] i18n assert"; npm run i18n:assert
echo "[pre-push] accessibility scan"; npm run a11y:scan
echo "[pre-push] wcag audit"; npm run wcag:audit

echo "→ pre-push: typecheck (strict)"; npm run typecheck:strict || { echo "✗ typecheck failed"; exit 1; }
echo "→ pre-push: tests"; npm run test:ci || { echo "✗ tests failed"; exit 1; }

# Allow unset I18N_TEST_BYPASS without nounset error; use default empty string
I18N_TEST_BYPASS_VAL="${I18N_TEST_BYPASS:-}" || true
if [ -z "$I18N_TEST_BYPASS_VAL" ]; then
  echo "→ pre-push: i18n validation"; npm run i18n:test || { echo "✗ i18n checks failed"; exit 1; }
else
  echo "→ pre-push: i18n validation skipped (I18N_TEST_BYPASS set)"
fi

echo "→ pre-push: i18n missing keys report"; npm run i18n:report || { echo "✗ missing i18n keys"; exit 1; }

echo "✓ pre-push checks passed"
