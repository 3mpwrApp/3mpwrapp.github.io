#!/usr/bin/env sh
# Empowr pre-commit: run lint-staged (ESLint + related tests)

# Allow skipping all hooks (e.g. emergency hotfix) by exporting SKIP_HOOKS=1
if [ "$SKIP_HOOKS" = "1" ]; then
	echo "↷ SKIP_HOOKS=1 -> skipping pre-commit"
	exit 0
fi

echo "→ Running lint-staged (pre-commit) with --no-stash"
# Ensure .eslintcache isn't partially staged noise
git reset -q HEAD .eslintcache 2>/dev/null || true
npx lint-staged --no-stash
rc=$?
if [ $rc -ne 0 ]; then
	echo "✗ lint-staged failed (commit aborted)"
	exit $rc
fi
echo "✓ lint-staged passed"

# Advisory check: warn on bad Tabs.Screen names (does not fail commit)
echo "→ Advisory: check Tabs.Screen names (slashes)"
npm run --silent check:tabs:names || true

# Optional: Validate folder structure (advisory only - doesn't fail commit)
if [ "$VALIDATE_STRUCTURE" = "1" ]; then
	echo "→ Validating folder structure"
	npm run --silent validate:structure || {
		echo "⚠ Structure validation failed (not blocking commit)"
		echo "  Run 'npm run validate:structure' to see details"
	}
fi
