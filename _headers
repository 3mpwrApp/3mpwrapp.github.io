# Security Headers for Cloudflare Pages
# Format: path pattern followed by headers (indented with 2 spaces)
# This file MUST be included in Jekyll output (see _config.yml include directive)

# Force fresh content for research page (no CDN caching)
/research
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/research/
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# Global security headers for ALL pages
/*
  # CRITICAL SECURITY HEADERS (fixes Mozilla Observatory grade D → A)
  
  # Content Security Policy - Prevents XSS attacks (-25 points if missing)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://gc.zgo.at https://challenges.cloudflare.com https://static.cloudflareinsights.com https://3mpwrapp-calendar.empowrapp08162025.workers.dev; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://challenges.cloudflare.com https://cloudflareinsights.com https://3mpwrapp-calendar.empowrapp08162025.workers.dev; frame-src https://docs.google.com https://challenges.cloudflare.com; base-uri 'self'; form-action 'self' https://duckduckgo.com https://docs.google.com https://formspree.io; frame-ancestors 'none'; object-src 'none'; media-src 'self'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests
  
  # Strict Transport Security - Forces HTTPS (-20 points if missing)
  # 2 years (63072000 seconds) with includeSubDomains and preload
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  
  # X-Frame-Options - Prevents clickjacking (-20 points if missing)
  X-Frame-Options: DENY
  
  # X-Content-Type-Options - Prevents MIME sniffing (required for passing)
  X-Content-Type-Options: nosniff
  
  # X-XSS-Protection - Legacy XSS protection (belt and suspenders)
  X-XSS-Protection: 1; mode=block
  
  # Referrer Policy - Controls referrer information (required for passing)
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Permissions Policy - Restricts dangerous browser features (recommended)
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), ambient-light-sensor=(), interest-cohort=()
  
  # Cross-Origin Policies - Enhanced security (recommended)
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  
  # Cache control for static assets (1 year)
  Cache-Control: public, max-age=31536000, immutable

# Google Drive OAuth callback - needs unsafe-none COOP to communicate with popup opener
# Must match all variations: /gdrive-callback, /gdrive-callback/, /gdrive-callback.html
/gdrive-callback
  Cross-Origin-Opener-Policy: unsafe-none
  Cross-Origin-Embedder-Policy: unsafe-none
  Cache-Control: no-cache, no-store, must-revalidate

/gdrive-callback/
  Cross-Origin-Opener-Policy: unsafe-none
  Cross-Origin-Embedder-Policy: unsafe-none
  Cache-Control: no-cache, no-store, must-revalidate

/gdrive-callback.html
  Cross-Origin-Opener-Policy: unsafe-none
  Cross-Origin-Embedder-Policy: unsafe-none
  Cache-Control: no-cache, no-store, must-revalidate

/gdrive-callback/
  Cross-Origin-Opener-Policy: unsafe-none
  Cross-Origin-Embedder-Policy: unsafe-none
  Cache-Control: no-cache, no-store, must-revalidate

/gdrive-callback/*
  Cross-Origin-Opener-Policy: unsafe-none
  Cross-Origin-Embedder-Policy: unsafe-none
  Cache-Control: no-cache, no-store, must-revalidate

/gdrive-callback.html
  Cross-Origin-Opener-Policy: unsafe-none
  Cross-Origin-Embedder-Policy: unsafe-none
  Cache-Control: no-cache, no-store, must-revalidate

# Service Worker - must be fresh
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# PWA Manifest - cache for 1 week
/manifest.json
  Cache-Control: public, max-age=604800, must-revalidate

# HTML pages - prefer fresh to avoid UI getting stuck
# IMPORTANT: Do NOT force Content-Type here, or CSS/JS will be served as text/html and blocked by browsers (nosniff).
/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Explicit rule for .html as well (some hosts require extension match)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# Ensure quick iteration for header overrides CSS (override generic CSS caching)
/assets/css/header-overrides.css
  Cache-Control: public, max-age=300, must-revalidate

# CSS - cache for 1 year (versioned via filename)
/*.css
  Cache-Control: public, max-age=31536000, immutable

# JavaScript - cache for 1 year (versioned via filename)
/*.js
  Cache-Control: public, max-age=31536000, immutable

# Images - cache for 1 month with stale-while-revalidate
/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400, immutable

/*.jpeg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400, immutable

/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400, immutable

/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400, immutable

/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400, immutable

/*.gif
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400, immutable

# Fonts - cache for 1 year
/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

/*.eot
  Cache-Control: public, max-age=31536000, immutable

# JSON data - cache for 5 minutes
/public/*.json
  Cache-Control: public, max-age=300, must-revalidate

# Android App Links - assetlinks.json must be JSON and publicly accessible
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# Updates database - cache for 10 minutes
/_data/updates.yml
  Cache-Control: public, max-age=600, must-revalidate

# No cache for dynamic search results
/search.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
