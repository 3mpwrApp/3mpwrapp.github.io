name: Commit Ingest To Weekly Queue

on:
  push:
    branches:
      - main

permissions:
  contents: write

jobs:
  ingest:
    runs-on: ubuntu-latest
    if: github.actor != 'github-actions[bot]'
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm

      - name: Install dependencies
        run: npm ci --ignore-scripts --no-audit --fund=false

      - name: Ingest commits to queue and update What is New
        run: node scripts/commit-ingest.js

      - name: Validate routing and deduplication
        run: node scripts/validate-content.js

      - name: Commit queue and feed changes
        run: |
          git config --local user.email "empowrapp08162025@gmail.com"
          git config --local user.name "3mpwrApp Content Bot"

          git add data/weekly-queue.json _whats_new/ || true
          if git diff --staged --quiet; then
            echo "No queue changes to commit"
            exit 0
          fi

          git commit -m "chore(automation): ingest commits into weekly queue and whats new"
          git push origin main

      - name: Dispatch to app repo to sync unified What's New feed
        run: |
          curl -s -X POST \
            -H "Accept: application/vnd.github+json" \
            -H "Authorization: Bearer ${{ secrets.CONTENT_BOT_TOKEN }}" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            https://api.github.com/repos/S0vryn9-C011ect1ve/empowrapp-main/dispatches \
            -d '{"event_type":"site-push","client_payload":{"source":"3mpwrapp-site","ref":"main"}}'
          echo "Dispatched site-push event to empowrapp-main"
