name: Lighthouse CI

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  schedule:
    - cron: "0 7 * * 1" # Weekly Monday 07:00 UTC
  workflow_dispatch:

# Cancel previous Lighthouse runs for the same ref to avoid overlap
concurrency:
  group: lighthouse-${{ github.ref }}
  cancel-in-progress: true

jobs:
  lhci:
    runs-on: ubuntu-latest
    # Enforcement: Performance and accessibility checks must pass
    timeout-minutes: 20
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Run Lighthouse CI on production (report-only)
        uses: treosh/lighthouse-ci-action@v12
        with:
          urls: |
            https://3mpwrapp.ca/
            https://3mpwrapp.ca/features
            https://3mpwrapp.ca/user-guide
            https://3mpwrapp.ca/blog
          configPath: './.lighthouserc.json'
          uploadArtifacts: true
          temporaryPublicStorage: true
