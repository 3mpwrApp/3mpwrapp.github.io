# Redirect old domains to new primary domain (301 permanent redirects)
https://3mpwrapp.pages.dev/* https://3mpwrapp.ca/:splat 301!
https://3mpwrapp.github.io/* https://3mpwrapp.ca/:splat 301!
https://www.3mpwrapp.ca/* https://3mpwrapp.ca/:splat 301!

# Exclude auth callbacks from SPA redirect
/gdrive-callback /gdrive-callback/index.html 200
/gdrive-callback.html /gdrive-callback/index.html 200

# Allow Jekyll-generated blog posts and pages to work
# Blog posts (Jekyll permalinks)
/20*/* 200!
# Static pages (Jekyll pretty URLs generate as directories)
/about /about/ 200
/research /research/ 200
/privacy /privacy/ 200
/security /security/ 200
/contact /contact/ 200
/faq /faq/ 200
/accessibility /accessibility/ 200

# SPA fallback for remaining routes (lower priority)
/* /index.html 200
