{
  "name": "empowrapp",
  "description": "A secure, privacy-first empowerment app with enterprise-grade security and complete user data ownership. Features air-gapped operation, AES-256 encryption, and OWASP Mobile Top 10 compliance.",
  "main": "expo-router/entry",
  "version": "1.0.0-rc.1",
  "scripts": {
    "start": "set EXPO_PUBLIC_DATA_POLICY=strict_byoc&& set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& expo start --tunnel",
    "prestart": "set EXPO_PUBLIC_DATA_POLICY=strict_byoc&& set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& node ./scripts/validate-configs.js",
    "start:devclient": "set EXPO_PUBLIC_DATA_POLICY=strict_byoc&& set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& node ./scripts/validate-configs.js && expo start --dev-client -c",
    "start:lan": "set EXPO_PUBLIC_DATA_POLICY=strict_byoc&& set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& expo start --lan -c",
    "start:localhost": "set EXPO_PUBLIC_DATA_POLICY=strict_byoc&& set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& expo start --localhost -c",
    "start:byoc": "set EXPO_PUBLIC_DATA_POLICY=strict_byoc&& expo start --clear",
    "validate": "node ./scripts/validate-configs.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "doctor": "expo doctor",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=0",
    "prepare": "husky",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "a11y:scan": "node scripts/a11y-scan.js",
    "wcag:audit": "node scripts/wcag-compliance-audit.js",
    "clean:win": "if exist node_modules rmdir /s /q node_modules && if exist package-lock.json del /f /q package-lock.json && if exist yarn.lock del /f /q yarn.lock && if exist pnpm-lock.yaml del /f /q pnpm-lock.yaml && npx expo install",
    "metro:clear": "set EXPO_NO_METRO_CACHE=1&& npx expo start -c",
    "align:expo": "npx expo install && npx expo install react-native@0.79.5",
    "admin:set": "node ./scripts/set-admin-claim.js",
    "admin:users": "node ./scripts/list-users.js",
    "admin:fcm": "node ./scripts/send-fcm.js",
    "admin:export": "node ./scripts/export-collection.js",
    "rules:deploy": "firebase deploy --only firestore:rules",
    "rules:deploy:storage": "firebase deploy --only storage",
    "i18n:diff": "node ./scripts/i18n-diff.js",
    "i18n:fill": "node ./scripts/i18n-fill-missing.js",
    "i18n:untranslated": "node ./scripts/i18n-untranslated.js",
    "i18n:export": "node ./scripts/i18n-export-untranslated.js",
    "i18n:extract": "node ./scripts/i18n-extract.js",
    "i18n:tag": "node ./scripts/i18n-tag-untranslated.js",
    "i18n:strip": "node ./scripts/i18n-strip-tags.js",
    "i18n:tag:check": "node ./scripts/i18n-check-tags.js",
    "i18n:threshold": "node ./scripts/i18n-threshold.js",
    "i18n:assert": "node ./scripts/i18n-assert-clean.js",
    "i18n:progress": "node ./scripts/i18n-progress-diff.js",
    "i18n:export:open": "I18N_OPEN=1 node ./scripts/i18n-export-untranslated.js",
    "i18n:plural": "node ./scripts/i18n-plural-check.js",
    "i18n:report": "node ./scripts/i18n-report-missing.js",
    "i18n:seed": "node ./scripts/i18n-seed-missing.js",
    "i18n:propagate": "node ./scripts/i18n-propagate-placeholders.js",
    "i18n:coverage": "node ./scripts/i18n-coverage.js",
    "i18n:check": "node ./scripts/check-i18n-keys.mjs",
    "i18n:test": "npm run i18n:tag:check && npm run i18n:diff && npm run i18n:plural && npm run i18n:threshold && npm run i18n:assert",
    "i18n:progress:update": "set I18N_UPDATE_SNAPSHOT=1&& node ./scripts/i18n-progress-diff.js",
    "i18n:orphans": "node ./scripts/i18n-orphans.js",
    "i18n:lint": "node ./scripts/i18n-lint-keys.js",
    "i18n:validate": "node ./scripts/i18n-validate-json.js",
    "scan:incomplete": "node ./scripts/scan-incomplete.mjs",
    "scan:incomplete:soft": "node ./scripts/scan-incomplete.mjs --soft",
    "seed:faqs": "node ./scripts/seed-faqs.js",
    "activity:seed": "node ./scripts/seed-faqs.js",
    "jurisdictions:gen": "node ./scripts/gen-jurisdictions-map.js",
    "sync:data": "node ./scripts/sync-data-to-public.mjs",
    "pretest": "npm run i18n:validate && node ./scripts/jest-clear-cache-safe.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:debug": "jest --detectOpenHandles --passWithNoTests",
    "test:guard": "node ./scripts/check-jsx-tests.js",
    "check:analytics": "node ./scripts/check-analytics-imports.mjs",
    "analytics:scan": "node ./scripts/analytics-scan.mjs",
    "analytics:report": "node ./scripts/analytics-report.mjs",
    "check:tabs:names": "node ./scripts/check-tabs-screen-names.mjs",
    "check:tabs:names:strict": "node ./scripts/check-tabs-screen-names.mjs --strict",
    "scan:inline": "node ./scripts/scan-inline-arrays.mjs",
    "whatsnew:gen": "node ./scripts/generate-whatsnew.mjs",
    "analytics:pii": "node ./scripts/analytics-pii-scan.mjs",
    "analytics:pii:soft": "set PII_SCAN_SOFT=1&& node ./scripts/analytics-pii-scan.mjs",
    "perf:budget": "node ./scripts/perf-bundle-budget.mjs",
    "perf:breakdown": "node ./scripts/perf-bundle-breakdown.mjs",
    "perf:max-file": "set PERF_MAX_ALLOW=components.*Content\\.tsx,LegalWorkflowEngine\\.tsx,campaign-coordinator\\.tsx,advanced-security\\.tsx,campaign-coordinator\\.impl\\.tsx,advanced-security\\.impl\\.tsx,onboarding\\.tsx,settings.*index\\.tsx&& node ./scripts/perf-max-file-size.mjs",
    "read:level": "node ./scripts/reading-level-scan.mjs",
    "test:ci": "npm run test:guard && npm run i18n:validate && npm run check:analytics && npm run analytics:report && npm run analytics:pii:soft && npm run perf:budget && npm run perf:breakdown && jest --runInBand --detectOpenHandles",
    "docs:privacy:pdf": "node ./scripts/html-to-pdf.mjs",
    "rebuild:android": "expo run:android --clean",
    "rebuild:ios": "expo run:ios --clean",
    "devclient:build:android": "npx eas build --profile development --platform android",
    "devclient:build:ios": "npx eas build --profile development --platform ios",
    "security:validate": "node ./scripts/security-validate.js",
    "security:test": "node ./scripts/security-test.js",
    "security:all": "npm run security:validate && npm run security:test",
    "byoc:test": "set EXPO_PUBLIC_DATA_POLICY=strict_byoc&& node ./scripts/test-byoc-private-cloud.js",
    "byoc:validate": "set EXPO_PUBLIC_DATA_POLICY=strict_byoc&& npm run security:validate",
    "validate:structure": "node ./scripts/validate-structure.mjs",
    "validate:structure:verbose": "node ./scripts/validate-structure.mjs --verbose",
    "validate:structure:report": "node ./scripts/validate-structure.mjs --report"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "cheerio": "^1.1.2",
    "crypto-js": "^4.2.0",
    "expo": "54.0.21",
    "expo-application": "~7.0.7",
    "expo-asset": "~12.0.9",
    "expo-audio": "~1.0.14",
    "expo-av": "~16.0.7",
    "expo-blur": "~15.0.7",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.16",
    "expo-device": "~8.0.9",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "~8.0.8",
    "expo-local-authentication": "^17.0.7",
    "expo-notifications": "~0.32.12",
    "expo-print": "~15.0.7",
    "expo-router": "~6.0.14",
    "expo-server-sdk": "^4.0.0",
    "expo-sharing": "~14.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~29.0.12",
    "expo-web-browser": "~15.0.8",
    "firebase": "^12.4.0",
    "pdf-parse": "^1.1.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-map-clustering": "^3.4.2",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "sentry-expo": "~7.0.0",
    "tesseract.js": "^6.0.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.9.1",
    "@types/react": "~19.1.0",
    "@types/testing-library__react": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.13.0",
    "deepl-node": "^1.20.0",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "firebase-admin": "^13.5.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jscpd": "^4.0.5",
    "lint-staged": "^15.2.10",
    "md-to-pdf": "^5.2.0",
    "puppeteer": "^23.8.0",
    "react-native-bundle-visualizer": "^3.1.3",
    "source-map-explorer": "^2.5.3",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.3",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "locales/*/common.json": [
      "npm run i18n:validate"
    ],
    "!.eslintcache": []
  },
  "overrides": {
    "@sentry/browser": "^7.119.1",
    "@sentry/react": "^7.119.1",
    "react": "19.1.0"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "private": true,
  "volta": {
    "node": "20.19.4"
  }
}
