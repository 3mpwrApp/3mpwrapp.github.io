{
  "name": "empowrapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& expo start --tunnel",
    "prestart": "set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& node ./scripts/validate-configs.js",
    "start:devclient": "set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& node ./scripts/validate-configs.js && expo start --dev-client -c",
    "start:lan": "set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& expo start --lan -c",
    "start:localhost": "set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& expo start --localhost -c",
    "validate": "node ./scripts/validate-configs.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:ci": "eslint . --quiet",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "a11y:scan": "node scripts/a11y-scan.js",
    "clean:win": "if exist node_modules rmdir /s /q node_modules && if exist package-lock.json del /f /q package-lock.json && if exist yarn.lock del /f /q yarn.lock && if exist pnpm-lock.yaml del /f /q pnpm-lock.yaml && npx expo install",
    "metro:clear": "set EXPO_NO_METRO_CACHE=1&& npx expo start -c",
    "align:expo": "npx expo install && npx expo install react-native@0.79.5",
    "admin:set": "node ./scripts/set-admin-claim.js",
    "admin:users": "node ./scripts/list-users.js",
    "admin:fcm": "node ./scripts/send-fcm.js",
    "admin:export": "node ./scripts/export-collection.js",
    "rules:deploy": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.22",
    "expo-av": "~15.1.7",
    "expo-blur": "~14.1.5",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.7",
    "expo-dev-client": "~5.2.4",
    "expo-document-picker": "~13.1.6",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.0",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.7",
    "expo-notifications": "~0.31.4",
    "expo-print": "~14.1.4",
    "expo-router": "~5.1.6",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "firebase": "^12.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5",
    "react-native-maps": "^1.15.4",
    "react-native-svg": "^15.4.0",
    "sentry-expo": "~7.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "firebase-admin": "^13.5.0",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "@sentry/browser": "^7.119.1",
    "@sentry/react": "^7.119.1"
  },
  "private": true
}
