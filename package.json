{
  "name": "empowrapp",
  "main": "expo-router/entry",
  "version": "1.0.0-rc.1",
  "scripts": {
    "start": "set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& expo start --tunnel",
    "prestart": "set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& node ./scripts/validate-configs.js",
    "start:devclient": "set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& node ./scripts/validate-configs.js && expo start --dev-client -c",
    "start:lan": "set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& expo start --lan -c",
    "start:localhost": "set EXPO_NO_METRO_FORK=1&& set EXPO_USE_METRO_FORK=0&& expo start --localhost -c",
    "validate": "node ./scripts/validate-configs.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "doctor": "expo doctor",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=0",
    "prepare": "husky",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "a11y:scan": "node scripts/a11y-scan.js",
    "clean:win": "if exist node_modules rmdir /s /q node_modules && if exist package-lock.json del /f /q package-lock.json && if exist yarn.lock del /f /q yarn.lock && if exist pnpm-lock.yaml del /f /q pnpm-lock.yaml && npx expo install",
    "metro:clear": "set EXPO_NO_METRO_CACHE=1&& npx expo start -c",
    "align:expo": "npx expo install && npx expo install react-native@0.79.5",
    "admin:set": "node ./scripts/set-admin-claim.js",
    "admin:users": "node ./scripts/list-users.js",
    "admin:fcm": "node ./scripts/send-fcm.js",
    "admin:export": "node ./scripts/export-collection.js",
    "rules:deploy": "firebase deploy --only firestore:rules",
    "rules:deploy:storage": "firebase deploy --only storage",
    "i18n:diff": "node ./scripts/i18n-diff.js",
    "i18n:fill": "node ./scripts/i18n-fill-missing.js",
    "i18n:untranslated": "node ./scripts/i18n-untranslated.js",
    "i18n:export": "node ./scripts/i18n-export-untranslated.js",
    "i18n:extract": "node ./scripts/i18n-extract.js",
    "i18n:tag": "node ./scripts/i18n-tag-untranslated.js",
    "i18n:strip": "node ./scripts/i18n-strip-tags.js",
    "i18n:tag:check": "node ./scripts/i18n-check-tags.js",
    "i18n:threshold": "node ./scripts/i18n-threshold.js",
    "i18n:assert": "node ./scripts/i18n-assert-clean.js",
    "i18n:progress": "node ./scripts/i18n-progress-diff.js",
    "i18n:export:open": "I18N_OPEN=1 node ./scripts/i18n-export-untranslated.js",
    "i18n:plural": "node ./scripts/i18n-plural-check.js",
    "i18n:report": "node ./scripts/i18n-report-missing.js",
    "i18n:seed": "node ./scripts/i18n-seed-missing.js",
    "i18n:propagate": "node ./scripts/i18n-propagate-placeholders.js",
    "i18n:coverage": "node ./scripts/i18n-coverage.js",
    "i18n:check": "node ./scripts/check-i18n-keys.mjs",
    "i18n:test": "npm run i18n:tag:check && npm run i18n:diff && npm run i18n:plural && npm run i18n:threshold && npm run i18n:assert",
    "i18n:progress:update": "set I18N_UPDATE_SNAPSHOT=1&& node ./scripts/i18n-progress-diff.js",
    "i18n:orphans": "node ./scripts/i18n-orphans.js",
    "i18n:lint": "node ./scripts/i18n-lint-keys.js",
    "seed:faqs": "node ./scripts/seed-faqs.js",
    "activity:seed": "node ./scripts/seed-faqs.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:guard": "node ./scripts/check-jsx-tests.js",
    "test:ci": "npm run test:guard && jest --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "^11.4.1",
    "cheerio": "^1.1.2",
    "expo": "~53.0.22",
    "expo-application": "~6.1.5",
    "expo-audio": "~0.4.9",
    "expo-av": "~15.1.7",
    "expo-blur": "~14.1.5",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.7",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-document-picker": "~13.1.6",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.0",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.7",
    "expo-notifications": "~0.31.4",
    "expo-print": "~14.1.4",
    "expo-router": "~5.1.6",
    "expo-server-sdk": "^4.0.0",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "firebase": "^12.2.1",
    "pdf-parse": "^1.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-map-clustering": "^3.4.2",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5",
    "sentry-expo": "~7.0.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.5.2",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "^19.1.0",
    "@types/testing-library__react": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "firebase-admin": "^13.5.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.1.2",
    "lint-staged": "^15.2.10",
    "react-test-renderer": "^19.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "!.eslintcache": []
  },
  "overrides": {
    "@sentry/browser": "^7.119.1",
    "@sentry/react": "^7.119.1"
  },
  "private": true
}
