    "typescript": "~5.9.3",
    "webpack-bundle-analyzer": "^5.1.0",
    "wrangler": "^4.56.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "locales/*/common.json": [
      "npm run i18n:validate"
    ],
    "!.eslintcache": []
  },
  "overrides": {
    "@sentry/browser": "^7.119.1",
    "@sentry/react": "^7.119.1",
    "node-forge": "^1.3.2",
    "js-yaml": "^4.1.1",
    "esbuild": "^0.25.4",
    "tar": "^7.5.2",
    "multer": "^1.4.5-lts.1",
    "react-server-dom-webpack": "18.2.0",
    "test-exclude": "^7.0.1"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "private": true,
  "volta": {
    "node": "20.19.4"
  }
