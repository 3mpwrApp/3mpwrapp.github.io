{
  "defaults": {
    "standard": "WCAG2AAA",
    "timeout": 30000,
    "wait": 1000,
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-dev-shm-usage"
      ]
    },
    "runners": [
      "axe",
      "htmlcs"
    ],
    "includeNotices": false,
    "includeWarnings": true,
    "hideElements": ".newsletter-modal, .cookie-banner",
    "screenCapture": "./reports/screenshots/{{filename}}.png",
    "actions": [
      "wait for element body to be visible",
      "set field #search to test",
      "click element button[type=submit]",
      "wait for url to not be https://3mpwrapp.github.io/search"
    ]
  },
  "urls": [
    {
      "url": "https://3mpwrapp.github.io/?no-modal=1",
      "timeout": 40000,
      "screenCapture": "./reports/screenshots/homepage.png"
    },
