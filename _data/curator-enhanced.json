  "headlineOptimization": {
    "patterns": [
      {
        "description": "Action-oriented wins",
        "template": "How [community] won [outcome] - and what it means for you",
        "example": "How injured workers won WSIB rate increase - and what it means for you"
      },
      {
        "description": "Deadline urgency",
        "template": "[Opportunity] closes [when] - Here's what you need to do",
        "example": "DTC application deadline extended to March - Here's what you need to do"
      },
      {
        "description": "Hidden benefit revelation",
        "template": "You may qualify for [benefit] - 3 things you need to know",
        "example": "You may qualify for Canada Disability Benefit - 3 things you need to know"
      },
      {
        "description": "Barrier removal",
        "template": "[Organization] removes barrier: Why [change] matters",
        "example": "Ontario removes waiting period: Why this accessibility win matters"
      },
      {
        "description": "Policy impact",
        "template": "New [policy] will [impact] — Here's your action plan",
        "example": "New AODA regulations will strengthen accessibility — Here's your action plan"
      }
    ]
  },
  "qualityChecks": {
    "naval_clarity": "Is the core insight clear in the first sentence? Can someone understand the relevance in 10 seconds?",
    "ogilvy_headline": "Does the headline pass the 'would I click this' test? Does it lead with benefit, not feature?",
    "annHandley_story": "Is there a clear reason-to-care? Does it speak to the reader's real situation?",
    "skim_test": "Can someone who has 30 seconds understand: what happened, why it matters, what to do?"
